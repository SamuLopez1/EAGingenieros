# Entorno del stack completo (docker compose). Copiar a `.env` y cambiar los
# secretos. `.env` está ignorado por Git; este archivo sí se versiona y por eso
# no debe contener nunca valores reales.

# --- Base de datos propia (PostgreSQL + pgvector) ---
POSTGRES_DB=eag
POSTGRES_USER=eag
# Cambiar antes de usar. El contenedor no arranca sin este valor.
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5446

# --- API ---
API_PORT=8132
EAG_ENVIRONMENT=development
EAG_APP_VERSION=0.1.0

# Secreto de firma de los tokens de sesión. Generar con:
#   openssl rand -base64 48
# Debe tener al menos 32 caracteres: con HS256 es la única barrera, y quien lo
# tenga puede emitir tokens válidos para cualquier usuario.
EAG_JWT_SECRET=

# Orígenes permitidos por CORS. En el stack completo la web comparte origen con
# la API a través de nginx, así que no hace falta; solo sirve para apuntar un
# Vite de desarrollo contra esta API. Nunca usar comodines.
EAG_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Web ---
WEB_PORT=8082

# --- Sincronización de fuentes SECOP ---
# El prefijo EAG_ es obligatorio: la configuración se lee con env_prefix EAG_.
# Token opcional de Socrata. Solo viaja en una cabecera y no se registra.
EAG_SOCRATA_APP_TOKEN=
EAG_SECOP_PAGE_SIZE=100
EAG_SECOP_TIMEOUT_SECONDS=20
EAG_SECOP_MAX_RETRIES=2
EAG_SECOP_MAX_REQUESTS=50

# --- Representación vectorial (RAG) ---
# Sin proveedor configurado se usa el representador local determinista, que no
# entiende de significado pero permite ejecutar el sistema completo. El modo se
# declara en /api/health para no confundirlo con recuperación semántica real.
EAG_EMBEDDINGS_BASE_URL=
EAG_EMBEDDINGS_API_KEY=
EAG_EMBEDDINGS_MODEL=

# --- Antivirus (opcional) ---
# Vacío significa que los archivos se aceptan sin analizar, y así se declara.
EAG_CLAMAV_HOST=
EAG_CLAMAV_PORT=3310
EAG_REQUIRE_ANTIVIRUS=false
