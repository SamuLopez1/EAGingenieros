# Sin esta variable, la API no habilita CORS para ningún origen.
EAG_CORS_ALLOWED_ORIGINS=http://localhost:5173
EAG_ENVIRONMENT=development
EAG_APP_VERSION=0.1.0

# Configuración de Supabase: completar solo en el entorno del backend.
# No copie una service_role key al navegador ni la añada a VITE_*. Los valores
# siguientes son marcadores, no una instancia ni una credencial real.
# EAG_SUPABASE_URL=https://project-ref.supabase.co
# EAG_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# EAG_SUPABASE_SERVICE_ROLE_KEY=service_role_placeholder
# Debe estar incluida exactamente en Redirect URLs de Supabase Auth.
# EAG_SUPABASE_INVITE_REDIRECT_URL=http://127.0.0.1:5173
# EAG_AUTH_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
# EAG_AUTH_ISSUER=https://project-ref.supabase.co/auth/v1
# EAG_AUTH_AUDIENCE=authenticated

# Persistencia PostgreSQL de oportunidades. Configurar solo en el servidor.
# EAG_DATABASE_URL=postgresql://usuario:clave@localhost:5432/eag
# EAG_SOCRATA_APP_TOKEN=
# EAG_SECOP_PAGE_SIZE=100
# EAG_SECOP_TIMEOUT_SECONDS=20
# EAG_SECOP_MAX_RETRIES=2
# EAG_SECOP_MAX_REQUESTS=50

# Expedientes privados. Configure el secreto y clamd únicamente en backend.
# EAG_DOCUMENT_DOWNLOAD_SECRET=
# EAG_DOCUMENT_CLAMAV_HOST=127.0.0.1
# EAG_DOCUMENT_CLAMAV_PORT=3310
# EAG_DOCUMENT_MAX_BYTES=52428800
# EAG_DOSSIER_MAX_BYTES=314572800
# EAG_DOCUMENT_RETENTION_DAYS=30
# EAG_OFFICIAL_DOCUMENT_MANIFEST=
