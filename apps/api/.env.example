# Configuración del backend. Este archivo se versiona: NUNCA poner valores reales.

# --- CORS ---
# Sin esta variable la API no habilita CORS para ningún origen.
EAG_CORS_ALLOWED_ORIGINS=http://localhost:5173
EAG_ENVIRONMENT=development
EAG_APP_VERSION=0.1.0

# --- Base de datos (Postgres de Supabase) ---
# Cadena de conexión del backend. Se obtiene en Supabase Dashboard >
# Settings > Database > Connection string > URI. Contiene la contraseña de la
# base, por lo que es un secreto de servidor: nunca lleva el prefijo VITE_.
# EAG_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase (servidor) ---
# Clave de servidor. Omite RLS por diseño, así que solo vive aquí.
# Nunca en el navegador ni en una variable VITE_.
# EAG_SUPABASE_URL=https://<ref>.supabase.co
# EAG_SUPABASE_SECRET_KEY=sb_secret_...
# Clave publicable: la usa la API para resolver la pertenencia del usuario
# contra PostgREST actuando como ese usuario, respetando RLS.
# EAG_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Validación de tokens de Supabase Auth ---
# La API verifica firma, expiración, issuer y audience antes de confiar en el
# sujeto del token. Los tres valores son obligatorios para habilitar el acceso.
# EAG_AUTH_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# EAG_AUTH_ISSUER=https://<ref>.supabase.co/auth/v1
# EAG_AUTH_AUDIENCE=authenticated
# URL a la que Supabase redirige tras confirmar una invitación.
# EAG_SUPABASE_INVITE_REDIRECT_URL=http://127.0.0.1:5173

# --- Sincronización de SECOP ---
# Token opcional de Socrata. Solo se envía en una cabecera y no se registra.
# SOCRATA_APP_TOKEN=
EAG_SECOP_PAGE_SIZE=100
EAG_SECOP_TIMEOUT_SECONDS=20
EAG_SECOP_MAX_RETRIES=2
EAG_SECOP_MAX_REQUESTS=50
